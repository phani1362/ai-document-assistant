# LLM provider: "openai" (default) or "gemini".
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
# Optional. Gemini's free tier allows only ~20 requests/day on Flash models.
GEMINI_API_KEY=

# Local Postgres from docker-compose. For the hosted demo, use a Neon connection string
# with the postgresql+psycopg:// scheme.
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag

# Embeddings: "local" (free, unmetered, runs BAAI/bge-base-en-v1.5 on CPU) or "gemini"
# (free tier allows ~100 texts/minute, too slow for bulk ingestion).
EMBEDDING_PROVIDER=local
